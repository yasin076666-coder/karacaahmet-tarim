rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) { return request.auth != null && request.auth.uid == userId; }

    // Her kayıt ayrı belge: users/{uid}/{tür}/{kayıtId} = { ownerUid, data, updatedAt }
    match /users/{userId}/{kind}/{docId} {
      function validKind() { return kind in ['sales', 'purchases', 'expenses', 'cards', 'cardPays', 'cashMoves', 'meta']; }
      allow read: if isOwner(userId) && validKind();
      allow create, update: if isOwner(userId) && validKind()
        && request.resource.data.keys().hasOnly(['ownerUid', 'data', 'updatedAt'])
        && request.resource.data.ownerUid == userId
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time
        && (kind == 'meta' ? docId == 'settings' : request.resource.data.data.id == docId);
      allow delete: if isOwner(userId) && validKind();
    }

    // Eski tek belgelik kayıt (revizyon 122'ye kadar): yalnızca okunur yedek. Eski sürüm artık yazamaz.
    match /users/{userId}/appData/{docId} {
      allow read: if isOwner(userId) && docId == 'main';
    }

    // Başka bütün belgeler kapalıdır.
    match /{document=**} { allow read, write: if false; }
  }
}
