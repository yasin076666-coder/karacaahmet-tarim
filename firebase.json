{
  "hosting": {
    "public": "public",
    "headers": [
      { "source": "/firebase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "**/*.@(html|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
    ]
  }
}
